---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import colton from "../assets/me_2026.png";
import {
  openSourceContributions,
  portfolioItems,
  rowSlug,
} from "../data/portfolio";

import { library, icon } from "@fortawesome/fontawesome-svg-core";
import { faGithub, faLinkedin } from "@fortawesome/free-brands-svg-icons";

// Declare all the icons you plan on using
library.add(faGithub, faLinkedin);

// Instantiate the icon with the icon function
const githubIcon = icon({ prefix: "fab", iconName: faGithub.iconName });
const linkedinIcon = icon({ prefix: "fab", iconName: faLinkedin.iconName });

// A few projects worth leading with; the rest live on /portfolio
const byTitle = (title: string) => {
  const item = [...portfolioItems, ...openSourceContributions].find(
    (candidate) => candidate.title === title,
  );
  if (!item) {
    throw new Error(`No portfolio entry titled "${title}"`);
  }
  return item;
};

const featured = [
  {
    ...byTitle("Geoconnex"),
    href: `/portfolio#${rowSlug("Geoconnex")}`,
  },
  {
    ...byTitle("US Bureau of Reclamation Reservoir Dashboard"),
    href: `/portfolio#${rowSlug("US Bureau of Reclamation Reservoir Dashboard")}`,
  },
  {
    ...byTitle("iceberg-go"),
    title: "Apache Iceberg",
    description:
      "Contributor to iceberg-go, the Go implementation of the Apache Iceberg table format",
    href: `/portfolio#${rowSlug("iceberg-go")}`,
  },
];
---

<Layout>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 pb-16">
    <!-- Hero -->
    <section
      class="flex flex-col-reverse items-center gap-8 pt-10 sm:pt-16 md:flex-row md:items-center md:gap-12"
    >
      <div class="md:flex-1">
        <h1 class="!text-left text-3xl sm:text-4xl font-bold leading-tight">
          Hi, I'm Colton.
        </h1>
        <p class="mt-4 text-lg sm:text-xl leading-relaxed">
          I'm a software engineer building global water data
          infrastructure at the <a
            href="https://www.lincolninst.edu/">Lincoln Institute of Land Policy</a
          >, a leading non-partisan land policy think tank in Cambridge Massachusetts. I'm a Princeton CS alum. 
        </p>
        <p class="mt-4 text-lg sm:text-xl leading-relaxed">
          I currently work on geospatial APIs, data pipelines, and the distributed systems that tie global water data
          together.
        </p>
        <p class="mt-4 text-lg sm:text-xl leading-relaxed">
          Outside of work I enjoy learning languages, hiking, and drawing.
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a
            href="/portfolio"
            class="gradient-cta !no-underline rounded-lg px-4 py-2 font-semibold text-neutral-900 shadow-md transition hover:opacity-80 active:scale-95 dark:text-neutral-100"
          >
            See my work
          </a>
          <a
            href="/contact"
            class="!no-underline rounded-lg px-4 py-2 font-semibold bg-neutral-100 text-neutral-900 shadow-md transition hover:opacity-80 active:scale-95 dark:bg-neutral-800 dark:text-neutral-100"
          >
            Get in touch
          </a>
        </div>

        <div class="mt-6 flex items-center gap-4 opacity-70">
          <a
            href="https://github.com/C-Loftus"
            class="w-6 h-6"
            title="GitHub"
            aria-label="GitHub"
          >
            <span set:html={githubIcon.html} />
          </a>
          <a
            href="https://www.linkedin.com/in/coltonl/"
            class="w-6 h-6"
            title="LinkedIn"
            aria-label="LinkedIn"
          >
            <span set:html={linkedinIcon.html} />
          </a>
        </div>
      </div>

      <div class="shrink-0">
        <Image
          src={colton}
          alt="Colton Loftus"
          title="Colton Loftus"
          class="rounded-full h-[10rem] w-[10rem] sm:h-[12rem] sm:w-[12rem] object-cover shadow-lg"
        />
      </div>
    </section>

    <!-- Selected work -->
    <section class="pt-14">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="!text-left">Selected work</h2>
        <a href="/portfolio" class="text-sm">All projects →</a>
      </div>

      <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-3">
        {
          featured.map((item) => (
            <a
              href={item.href}
              class="!no-underline flex h-full flex-col rounded-2xl p-5 bg-neutral-100 text-neutral-700 shadow-lg transition-all duration-200 ease-in-out hover:shadow-xl active:scale-95 dark:bg-neutral-800 dark:text-neutral-300 dark:shadow-black/30"
            >
              <h3 class="!font-medium">{item.title}</h3>
              <p class="mt-2 !text-base text-neutral-600 dark:text-neutral-400">
                {item.description}
              </p>
              <div class="mt-auto pt-4 flex flex-wrap gap-2">
                {item.languages.map((lang) => (
                  <span class="rounded-full px-2 py-0.5 text-xs bg-neutral-200 text-neutral-600 dark:bg-neutral-700 dark:text-neutral-300">
                    {lang}
                  </span>
                ))}
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Same gradient as the bar pinned to the top of every page. Used as a ring
     rather than a fill: no single text color stays legible across all three
     stops. */
  .gradient-cta {
    --cta-surface: #fff;
    border: 3px solid transparent;
    background-image:
      linear-gradient(var(--cta-surface), var(--cta-surface)),
      linear-gradient(90deg, #5d2f86, #8ed6fb 50%, #08e756);
    background-origin: border-box;
    background-clip: padding-box, border-box;
  }

  :global([data-theme="dark"]) .gradient-cta {
    --cta-surface: #171717;
  }
</style>
